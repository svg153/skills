{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "apm"
  ],
  "dependencyDashboard": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 8am on Monday"
    ]
  },
  "packageRules": [
    {
      "description": "External Agent Skills require reviewed dependency PRs",
      "matchManagers": [
        "apm"
      ],
      "automerge": false,
      "semanticCommitType": "chore",
      "semanticCommitScope": "skills"
    }
  ]
}
